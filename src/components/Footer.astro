---
import { siteConfig } from '../site-config';

const today = new Date();
const externalLinks = siteConfig.externalLinks;
---

<footer>
<div class="footer-inner">
<div class="identity-block">
<p class="eyebrow">{siteConfig.identity.brand}</p>
<h2>{siteConfig.identity.displayName}</h2>
<p>{siteConfig.identity.tagline}</p>
</div>
<div>
<h3>Navigate</h3>
<ul>
{siteConfig.navigation.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
</ul>
</div>
<div>
<h3>Connect</h3>
<ul>
{externalLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
</ul>
</div>
</div>
<p class="legal">&copy; {today.getFullYear()} {siteConfig.identity.displayName}</p>
</footer>
<style>
footer {
margin-top: 4rem;
padding: 2rem 1rem 3rem;
border-top: 1px solid rgba(var(--color-border), 0.32);
background: rgba(var(--color-surface), 0.55);
}
.footer-inner {
width: min(1120px, calc(100% - 2rem));
margin: 0 auto;
display: grid;
grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(0, 1fr));
gap: 2rem;
}
.identity-block h2,
.identity-block p,
h3,
ul {
margin: 0;
}
.eyebrow {
margin-bottom: 0.75rem;
color: rgb(var(--color-accent));
font-size: 0.75rem;
font-weight: 700;
letter-spacing: 0.12em;
text-transform: uppercase;
}
h2 {
font-size: 1.4rem;
}
.identity-block > p:last-child {
margin-top: 0.75rem;
color: rgb(var(--color-text-muted));
}
h3 {
margin-bottom: 0.85rem;
font-size: 1rem;
}
ul {
padding: 0;
list-style: none;
display: grid;
gap: 0.7rem;
}
a {
color: rgb(var(--color-text-muted));
}
a:hover {
color: rgb(var(--color-text));
}
.legal {
width: min(1120px, calc(100% - 2rem));
margin: 2rem auto 0;
padding-top: 1.5rem;
border-top: 1px solid rgba(var(--color-border), 0.2);
color: rgb(var(--color-text-muted));
font-size: 0.95rem;
}
@media (max-width: 800px) {
.footer-inner {
grid-template-columns: 1fr;
}
}
</style>
