---
import HeaderLink from './HeaderLink.astro';
import { siteConfig } from '../site-config';

const socialLinks = siteConfig.externalLinks.filter(({ label }) => label !== 'Email');
---

<header>
<nav aria-label="Primary">
<a class="brand" href="/">
<span>{siteConfig.identity.brand}</span>
<small>{siteConfig.identity.owner}</small>
</a>
<div class="internal-links">
{siteConfig.navigation.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
</div>
<div class="external-links" aria-label="Social links">
{
socialLinks.map((link) => (
<a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
))
}
</div>
</nav>
</header>
<style>
header {
position: sticky;
top: 0;
z-index: 10;
backdrop-filter: blur(18px);
background: rgba(var(--color-surface), 0.78);
border-bottom: 1px solid rgba(var(--color-border), 0.4);
}
.brand {
display: inline-flex;
flex-direction: column;
gap: 0.15rem;
padding: 1rem 0;
color: rgb(var(--color-text));
}
.brand span {
font-size: 0.95rem;
font-weight: 700;
letter-spacing: 0.12em;
}
.brand small {
color: rgb(var(--color-text-muted));
font-size: 0.8rem;
}
nav {
width: min(1120px, calc(100% - 2rem));
margin: 0 auto;
display: flex;
align-items: center;
justify-content: space-between;
gap: 1rem;
}
.internal-links,
.external-links {
display: flex;
align-items: center;
gap: 0.25rem;
flex-wrap: wrap;
}
.external-links a {
padding: 0.75rem 0.8rem;
color: rgb(var(--color-text-muted));
font-size: 0.95rem;
}
.external-links a:hover {
color: rgb(var(--color-text));
}
@media (max-width: 900px) {
nav {
padding: 0.5rem 0 0.85rem;
flex-direction: column;
align-items: flex-start;
}
.brand {
padding-bottom: 0;
}
}
@media (max-width: 640px) {
.external-links {
display: none;
}
}
</style>
