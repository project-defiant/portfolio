---
import FormattedDate from '../components/FormattedDate.astro';
import type { PreparedBlogPost } from '../content/blog';
import SiteLayout from './SiteLayout.astro';

interface Props {
post: PreparedBlogPost;
}

const { post } = Astro.props;
const {
title,
description,
pubDate,
updatedDate,
heroImage,
heroImageAlt,
tags,
readingTimeMinutes,
} = post;
---

<SiteLayout title={title} description={description} image={heroImage} mainClass="post-shell">
<Fragment slot="head">
<style>
.post-shell {
width: min(100%, 960px);
max-width: calc(100% - 2rem);
}

.post-article {
display: grid;
gap: 1.75rem;
}

.post-header {
display: grid;
gap: 1rem;
padding: 1.75rem;
border-radius: 32px;
background: rgba(var(--color-surface), 0.8);
border: 1px solid rgba(var(--color-border), 0.22);
}

.post-header > * {
margin: 0;
}

.post-collection a {
font-size: 0.9rem;
letter-spacing: 0.08em;
text-transform: uppercase;
color: rgb(var(--color-text-muted));
}

.post-description {
max-width: 42rem;
color: rgb(var(--color-text-muted));
}

.post-meta {
display: flex;
flex-wrap: wrap;
gap: 0.75rem 1.25rem;
color: rgb(var(--color-text-muted));
font-size: 0.95rem;
}

.post-meta p {
margin: 0;
}

.post-tags {
list-style: none;
padding: 0;
margin: 0;
display: flex;
flex-wrap: wrap;
gap: 0.65rem;
}

.post-tags a {
display: inline-flex;
padding: 0.4rem 0.8rem;
border-radius: 999px;
background: rgba(var(--color-surface-muted), 0.9);
color: rgb(var(--color-text-muted));
font-size: 0.85rem;
}

.post-hero {
margin: 0;
}

.post-hero img {
display: block;
width: min(100%, 760px);
margin: 0 auto;
border-radius: 28px;
border: 1px solid rgba(var(--color-border), 0.26);
}

.prose {
width: min(720px, 100%);
margin: 0 auto;
}

@media (max-width: 720px) {
.post-header {
padding: 1.2rem;
border-radius: 24px;
}

.post-meta {
font-size: 0.9rem;
}
}
</style>
</Fragment>
<article class="post-article">
<header class="post-header">
<p class="post-collection"><a href="/blog/">Blog</a></p>
<h1>{title}</h1>
<p class="post-description">{description}</p>
<div class="post-meta">
<p>Published <FormattedDate date={pubDate} /></p>
{updatedDate && <p>Updated <FormattedDate date={updatedDate} /></p>}
<p>{readingTimeMinutes} min read</p>
</div>
{
tags.length > 0 && (
<ul class="post-tags" aria-label={`Topics for ${title}`}>
{
tags.map((tag) => (
<li>
<a href={`/blog/tags/${tag.slug}/`}>{tag.label}</a>
</li>
))
}
</ul>
)
}
</header>
{
heroImage && (
<figure class="post-hero">
<img width={1020} height={680} src={heroImage} alt={heroImageAlt ?? ''} />
</figure>
)
}
<div class="prose">
<slot />
</div>
</article>
</SiteLayout>
