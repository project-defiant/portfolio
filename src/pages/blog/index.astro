---
import BlogPostList from '../../components/blog/BlogPostList.astro';
import BlogTagFilters from '../../components/blog/BlogTagFilters.astro';
import { collectBlogTags, getPreparedBlogPosts } from '../../content/blog';
import SiteLayout from '../../layouts/SiteLayout.astro';

const posts = await getPreparedBlogPosts();
const tags = collectBlogTags(posts);
---

<SiteLayout
title="Blog"
description="Essays, notes, and technical field reports published under PROJECT-DEFIANT."
mainClass="blog-shell"
>
<Fragment slot="head">
<style>
.blog-shell {
width: min(100%, 960px);
max-width: calc(100% - 2rem);
}

.blog-intro {
display: grid;
gap: 0.85rem;
margin-bottom: 2rem;
}

.blog-intro__eyebrow {
margin: 0;
font-size: 0.85rem;
letter-spacing: 0.1em;
text-transform: uppercase;
color: rgb(var(--color-text-muted));
}

.blog-intro h1,
.blog-intro p {
margin: 0;
}

.blog-intro p:last-child {
max-width: 42rem;
color: rgb(var(--color-text-muted));
}
</style>
</Fragment>

<section class="blog-intro">
<p class="blog-intro__eyebrow">Blog</p>
<h1>Local essays, notes, and build logs.</h1>
<p>
A calmer editorial archive for PROJECT-DEFIANT writing, with clear metadata and lightweight topic filtering.
</p>
</section>

<BlogTagFilters tags={tags} />
<BlogPostList posts={posts} />
</SiteLayout>
