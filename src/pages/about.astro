---
import SiteLayout from '../layouts/SiteLayout.astro';
import { aboutIdentity, aboutNarrative, aboutTraits } from '../data/about-content';
---

<SiteLayout title="About" description="The narrative arc behind PROJECT-DEFIANT: biotechnology, omics, software engineering, and the traits that shape the work.">
  <section class="hero">
    <p class="eyebrow">About</p>
    <h1>Szymon Szyszkowski</h1>
    <p class="lede">
      PROJECT-DEFIANT is the prose-first home for the path that connects childhood curiosity,
      biotechnology, genome work, omics, and software engineering.
    </p>
  </section>

  <section class="narrative" aria-labelledby="about-arc-title">
    <div class="section-heading">
      <p class="eyebrow">Narrative arc</p>
      <h2 id="about-arc-title">From life science to software, without losing either.</h2>
    </div>
    <div class="story-grid">
      {aboutNarrative.map((section) => (
        <article class="story-card">
          <p class="card-eyebrow">{section.eyebrow}</p>
          <h3>{section.title}</h3>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </article>
      ))}
    </div>
  </section>

  <section class="identity" aria-labelledby="about-identity-title">
    <div class="section-heading">
      <p class="eyebrow">Identity</p>
      <h2 id="about-identity-title">Inventor, scientist, and engineer.</h2>
    </div>
    <div class="identity-copy">
      {aboutIdentity.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="traits" aria-labelledby="about-traits-title">
    <div class="section-heading">
      <p class="eyebrow">Traits</p>
      <h2 id="about-traits-title">The principles that keep the work moving.</h2>
    </div>
    <ul class="trait-grid">
      {aboutTraits.map((trait) => (
        <li class="trait-card">
          <h3>{trait.title}</h3>
          <p>{trait.description}</p>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>

<style>
  .hero,
  .narrative,
  .identity,
  .traits {
    display: grid;
    gap: 1.25rem;
  }

  .hero {
    padding-top: 1rem;
  }

  .section-heading {
    display: grid;
    gap: 0.55rem;
  }

  .eyebrow,
  .card-eyebrow {
    margin: 0;
    color: rgb(var(--color-accent));
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lede,
  .identity-copy,
  .story-card p,
  .trait-card p {
    max-width: 42rem;
    margin: 0;
  }

  .narrative,
  .identity,
  .traits {
    margin-top: 3rem;
  }

  .story-grid,
  .trait-grid {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .story-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .trait-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .story-card,
  .trait-card,
  .identity-copy {
    padding: 1.4rem;
    border: 1px solid rgba(var(--color-border), 0.28);
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(var(--color-surface), 0.88), rgba(var(--color-surface-muted), 0.62));
    box-shadow: var(--box-shadow);
  }

  .story-card,
  .trait-card {
    display: grid;
    gap: 0.85rem;
  }

  .story-card h3,
  .trait-card h3,
  .section-heading h2 {
    margin: 0;
  }

  .identity-copy {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .story-grid,
    .trait-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
